MURAL_CLIENT_ID=your-client-id
MURAL_CLIENT_SECRET=your-client-secret
MURAL_REFRESH_TOKEN=your-refresh-token

# To get the initial refresh token, complete the OAuth2 authorization code
# flow once:
#
# 1. Open in browser (replace YOUR_CLIENT_ID and YOUR_REDIRECT_URI):
#    https://app.mural.co/api/public/v1/authorization/oauth2/?client_id=YOUR_CLIENT_ID&redirect_uri=YOUR_REDIRECT_URI&scope=murals:read%20murals:write%20rooms:read%20workspaces:read&response_type=code
#
# 2. After authorizing, you'll be redirected to YOUR_REDIRECT_URI?code=AUTH_CODE
#
# 3. Exchange the code for tokens:
#    curl -X POST https://app.mural.co/api/public/v1/authorization/oauth2/token \
#      -d "client_id=YOUR_CLIENT_ID" \
#      -d "client_secret=YOUR_CLIENT_SECRET" \
#      -d "redirect_uri=YOUR_REDIRECT_URI" \
#      -d "code=AUTH_CODE" \
#      -d "grant_type=authorization_code"
#
# 4. Copy the refresh_token from the response into MURAL_REFRESH_TOKEN above.
#    The server will auto-refresh the access token from then on.
